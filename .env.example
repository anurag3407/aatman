# Copy to .env.local for development (`pnpm setup:env` does this with fresh random keys).
# In production, set these in your host's secret manager. Never commit real values.

# Public URL of the app, used for OAuth redirects and same-origin checks.
APP_URL=http://localhost:3000

# Postgres in production (India region, e.g. AWS ap-south-1 / Azure Central India).
# Local dev and tests can use embedded Postgres: pglite:./.data/pglite or pglite:memory
DATABASE_URL=pglite:./.data/pglite

# ≥ 32 random characters each: openssl rand -base64 48
SESSION_SECRET=
# HMAC key for student pseudonyms. If you lose or change it, every student loses access to their history.
PSEUDONYM_KEY=
# 32 random bytes, base64: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Students must sign in with these domains.
ALLOWED_EMAIL_DOMAINS=nitp.ac.in

# SSO. Configure at least one in production.
# Google: OAuth client (Web), redirect URI {APP_URL}/api/auth/callback/google, internal to the Workspace.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra: app registration, redirect URI {APP_URL}/api/auth/callback/microsoft, single tenant.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Staff (comma-separated institute emails). Counsellors see shared data; admins see aggregates only.
COUNSELLOR_EMAILS=
ADMIN_EMAILS=

# Local only: sign in as any @ALLOWED_EMAIL_DOMAINS address without SSO. Refused in production.
DEV_LOGIN=false

# LLM: none (templates only) | anthropic | openai_compat (self-hosted vLLM/Ollama) | mock (tests)
LLM_PROVIDER=none
# anthropic default: claude-opus-5-5. Required for openai_compat.
LLM_MODEL=
LLM_TIMEOUT_MS=20000
# Anthropic server-side refusal fallback (re-runs a declined request on a suitable model).
LLM_REFUSAL_FALLBACK=true
ANTHROPIC_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Required in production. The daily scheduler sends it to POST /api/cron/retention.
CRON_SECRET=
RETENTION_MONTHS=12

# Hostel/block names removed from chat text before it reaches an LLM (comma-separated).
HOSTEL_NAMES=
