# Production settings for the VPS. deploy/scripts/init-env.sh copies this to
# /opt/aatman/shared/.env with fresh random secrets; fill in the rest by hand.
# Read by Docker Compose (for ${…} in compose.yaml) and passed to the app.
# Never commit the filled-in copy. Back it up somewhere other than the database backups.

# ── Server ──────────────────────────────────────────────────────────────────
# Public hostname. DNS A/AAAA records must point at this VPS before the first deploy,
# so Caddy can get a Let's Encrypt certificate.
DOMAIN=aatman.example.ac.in
# Let's Encrypt account / expiry notices.
ACME_EMAIL=
# Must be https://$DOMAIN. Used for OAuth redirects and same-origin checks.
APP_URL=https://aatman.example.ac.in

# `db` runs the bundled Postgres container. Remove it (leave empty) when DATABASE_URL
# points at a managed Postgres instead.
COMPOSE_PROFILES=db

# ── Scaling ─────────────────────────────────────────────────────────────────
# App replicas on this VPS. Each is stateless; Caddy balances across them.
# Rough guide: 1 replica per vCPU, each needs ~300–500 MB RAM under load.
APP_REPLICAS=2
APP_MEMORY_LIMIT=768m
APP_CPU_LIMIT=1.0
# Postgres connections per replica. Keep APP_REPLICAS × DATABASE_POOL_MAX + 5 below PG_MAX_CONNECTIONS.
DATABASE_POOL_MAX=10

# ── Database ────────────────────────────────────────────────────────────────
# Bundled Postgres (COMPOSE_PROFILES=db). Hex only, so it's safe inside a URL.
POSTGRES_PASSWORD=
# Bundled: postgres://aatman:<POSTGRES_PASSWORD>@postgres:5432/aatman
# Managed (India region): postgres://user:pass@host:5432/aatman?sslmode=require
DATABASE_URL=
# Bundled Postgres tuning. Defaults suit a 4 GB VPS; on 8 GB double the first three.
PG_MEMORY_LIMIT=1g
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
PG_MAX_CONNECTIONS=100
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=64MB

# ── Backups and scheduled jobs (cron container, times in UTC) ───────────────
BACKUP_DIR=/opt/aatman/backups
BACKUP_KEEP_DAYS=14
BACKUP_SCHEDULE="0 21 * * *"
RETENTION_SCHEDULE="30 21 * * *"
# Crisis escalation + notification outbox. Every minute is intentional.
ALERT_SCHEDULE="* * * * *"

# ── App secrets (generated by init-env.sh) ──────────────────────────────────
SESSION_SECRET=
# If you lose or change it, every student loses access to their history.
PSEUDONYM_KEY=
# 32 bytes, base64. Losing it makes every stored answer unreadable.
DATA_ENCRYPTION_KEY=
CRON_SECRET=

# ── Sign-in ─────────────────────────────────────────────────────────────────
ALLOWED_EMAIL_DOMAINS=nitp.ac.in
# Configure at least one. Redirect URIs: https://$DOMAIN/api/auth/callback/google
# and https://$DOMAIN/api/auth/callback/microsoft
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
# Comma-separated institute emails.
COUNSELLOR_EMAILS=
ADMIN_EMAILS=
# Crisis routing: fallback recipients when no on-call shift covers the moment. Required.
ALERT_EMAILS=
CLINICAL_LEAD_EMAILS=
# POST { to, subject, text } to your institute relay or email provider. Required.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=
# SMS reminders: POST { to, text } to your provider or relay.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Must stay false in production (the app refuses to start otherwise).
DEV_LOGIN=false

# ── LLM ─────────────────────────────────────────────────────────────────────
# none | anthropic | openai_compat. `none` is fully functional without any LLM.
LLM_PROVIDER=none
LLM_MODEL=
LLM_TIMEOUT_MS=20000
LLM_REFUSAL_FALLBACK=true
ANTHROPIC_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# ── Data handling ───────────────────────────────────────────────────────────
RETENTION_MONTHS=12
HOSTEL_NAMES=
